GRAMMAR_EMPTY=
GRAMMAR_DOUBLE="npm --prefix apps/nextjs run dev"
GRAMMAR_SINGLE='https://api.example.test/orders#tests'
GRAMMAR_HASH_IN_QUOTES="R&D + QA # not a comment"
  # An indented comment line.
GRAMMAR_TRAILING_SPACE=value   
GRAMMAR_EQUALS=a=b
