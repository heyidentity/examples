# HeyIdentity example settings (see CONTRACT.md).
# Copy this file to .env in the repository root and fill it in, or run
#   node setup/provision.mjs --temporary
# to create a temporary configuration that writes .env for you.

# The configuration's issuer: Connect your app -> Authority (issuer).
# For example https://app.heyidentity.dev/t/<tenantRouteId>/c/<configurationId>
OIDC_AUTHORITY=

# Clients -> Client ID of a public client (no secret) whose redirect URIs are exactly
# http://localhost:5173/callback and http://localhost:5173/
OIDC_CLIENT_ID=

# Users -> key of a user whose roles claim contains admin, for example admin.
ADMIN_USER_KEY=

# Users -> key of a user whose roles claim contains reader and not admin, for example reader.
READER_USER_KEY=

# Optional: the port the app listens on (default 5173). Changing it changes both redirect URIs.
# APP_PORT=5173

# Server-side apps only; never exposed to a browser.
# OIDC_CLIENT_SECRET=
