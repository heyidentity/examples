# HeyIdentity example settings (see CONTRACT.md).
# Copy this file to .env in the repository root and fill it in, or run
#   node setup/provision.mjs --temporary
# to create a temporary configuration that writes .env for you.

# The configuration's issuer: Connect your app -> Authority (issuer).
# For example https://app.heyidentity.dev/t/<tenantRouteId>/c/<configurationId>
OIDC_AUTHORITY=

# Clients -> Client ID. Register the exact callback for your app and the logout return at http://localhost:5173/.
# CONTRACT.md lists the callbacks. Leave "Allow all return URLs" off. Temporary setup creates example-app.
OIDC_CLIENT_ID=

# Users -> key of a user whose roles claim contains admin, for example admin.
ADMIN_USER_KEY=

# Users -> key of a user whose roles claim contains reader and not admin, for example reader.
READER_USER_KEY=

# Optional: the port the app listens on (default 5173). Changing it changes the registered URLs.
# APP_PORT=5173

# Optional: a shell command, run from the repository root, that installs and starts the app under test on APP_PORT.
# Every suite uses it for its web server step; without it a suite starts its default app (TypeScript: apps/react).
# EXAMPLE_APP_COMMAND=

# Only for a server-side app whose client checks secrets (validate_client_secrets on); never exposed to a browser.
# OIDC_CLIENT_SECRET=

# Blazor only. Use the Microsoft profile and its Entra issuer for OIDC_AUTHORITY.
# ENTRA_INSTANCE=
# ENTRA_TENANT_ID=

# Next.js only. Generate a separate server-only Auth.js session secret.
# AUTH_SECRET=

# ASP.NET Core API integration example only. Use the client's configured access-token audience.
# It must differ from OIDC_CLIENT_ID.
# API_AUDIENCE=
